class Solution {
    public int nthRoot(int n, int m) {
        // code here
        int l=1;
        int r=m;
        if(m==0)return 0;
        while(l<=r)
        {
            int md=(l+r)/2;
            long ans = 1;
            for (int i = 0; i < n; i++) {
                ans *= md;
                if (ans > m) break;
            }
            if(ans==m)
            {
            return md;
            }
            if(ans<m)
            {
             l=md+1;
            }
            else
            {
            r=md-1;
            }
        }
        return -1;
    }
}
