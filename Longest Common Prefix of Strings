class Solution {
    public String longestCommonPrefix(String arr[]) {
        // code here
        Arrays.sort(arr);
        String s=arr[0];
        String l=arr[arr.length-1];
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<Math.min(s.length(),l.length());i++)
        {
            if(s.charAt(i)==l.charAt(i))
            {
                sb.append(s.charAt(i));
            }
            else
            {
                break;
            }
        }
        return sb.toString();
    }
}
