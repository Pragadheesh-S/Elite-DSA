class Solution {
	public String removeOuter(String s) {
		// code here
	StringBuilder sb=new StringBuilder();
		int n=s.length();
		int d=0;
	    for(int i=0;i<n;i++)
	    {
	        if(s.charAt(i)=='(')
	        {
	            if(d>0) sb.append(s.charAt(i));
	            d++;
	        }
	        else
	        {
	            d--;
	            if(d>0) sb.append(s.charAt(i));
	        }
	    }
	    return sb.toString();
	}
}
