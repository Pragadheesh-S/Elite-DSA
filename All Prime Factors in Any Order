class Solution {
    ArrayList<Integer> primeFactors(int n) {
        // code here 
        ArrayList<Integer> al=new ArrayList<>();
        while(n%2==0){
            al.add(2);
            n/=2;
        }
        
        for(int i=3;i<=Math.sqrt(n);i++)
        {
            while(n%i==0)
            {
                al.add(i);
                n/=i;
            }
        }
        if(n>1)
        {
            al.add(n);
        }
        
        return al;
    }
}
