class Solution {
    int search(int[] arr, int key) {
        int st = 0;
        int ed = arr.length - 1;

        while (st <= ed) {
            int m = st + (ed - st) / 2;

            if (arr[m] == key) {
                return m;
            }

            if (arr[st] <= arr[m]) {
                if (key >= arr[st] && key < arr[m]) {
                    ed = m - 1;
                } else {
                    st = m + 1;
                }
            }
            else {
                if (key > arr[m] && key <= arr[ed]) {
                    st = m + 1;
                } else {
                    ed = m - 1;
                }
            }
        }

        return -1;
    }
}
