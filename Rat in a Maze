class Solution {
	static int[] d = {1, 0, -1, 0, 1};
	static char[] dd={'D','L','U','R'};
	private void dfs(int [][] mat, int r, int c, int R, int C,boolean[][] vis,ArrayList<String>al,StringBuilder sb)
	{
	    if (r == R-1 && c == C-1)
			{
			   al.add(sb.toString());
			   return;
			}
		
		for (int i = 0; i<4; i++)
			{
			int nr = r + d[i];
			int nc = c + d[i + 1];
			if (nr<R && nr >= 0 && nc<C && nc >= 0 && mat[nr][nc] == 1 && vis[nr][nc] != true)
				{
				vis[nr][nc] = true;
				sb.append(dd[i]);
				dfs(mat, nr, nc, R, C, vis, al,sb);
				sb.deleteCharAt(sb.length()-1);
				vis[nr][nc] = false;
			}
		}

	}
	public ArrayList<String> ratInMaze(int[][] mat) {
		// code here
		int r = mat.length;
		int c = mat[0].length;
		if (mat[0][0] == 0 || mat[r - 1][c - 1] == 0)
			return new ArrayList<>();
		  StringBuilder sb = new StringBuilder();
		boolean[][] vis = new boolean[r][c];
		ArrayList<String>al = new ArrayList<>();
		vis[0][0]=true;
		dfs(mat, 0, 0, r, c, vis, al,sb);
		Collections.sort(al);
		return al;
		
	}
}
