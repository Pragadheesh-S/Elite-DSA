class Solution {
	private void gen(HashMap<Integer, String> hm, ArrayList<String> al, int[] arr, String s, int i)
	{
		if (i == arr.length)
			{
			al.add(s);
			return;
		}
		String lt = hm.get(arr[i]);
		if (lt == null)
			{
			gen(hm, al, arr, s, i + 1);
			return;
		}
		for (char c:lt.toCharArray())
			{
			gen(hm, al, arr, s + c, i + 1);
		}
	}
	public ArrayList<String> possibleWords(int[] arr) {
		// code here
		HashMap<Integer, String>hm = new HashMap<>();
		hm.put(2, "abc");
		hm.put(3, "def");
		hm.put(4, "ghi");
		hm.put(5, "jkl");
		hm.put(6, "mno");
		hm.put(7, "pqrs");
		hm.put(8, "tuv");
		hm.put(9, "wxyz");
		ArrayList<String>al = new ArrayList<>();
		gen(hm, al, arr, "", 0);
		return al;
	}
}
