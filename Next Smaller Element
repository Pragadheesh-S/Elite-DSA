class Solution {
    static ArrayList<Integer> nextSmallerEle(int[] arr) {
        // code here
        int n=arr.length;
        Stack<Integer> st=new Stack<>();
        for(int i=n-1;i>=0;i--)
        {
            int v=arr[i];
            while(!st.isEmpty() && st.peek()>=v)
            {
                st.pop();
            }
            arr[i]=st.isEmpty()? -1: st.peek();
        
        st.push(v);
        }
        ArrayList<Integer> al = new ArrayList<>();
        for (int num : arr) {
            al.add(num);
        }

        return al;
    }
}
