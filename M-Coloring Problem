class Solution {
	private boolean isSafe(int node, int col, int[] color, boolean[][] graph, int V) {
		for (int i = 0; i < V; i++) {
			if (graph[node][i] && color[i] == col) {
				return false;
			}
		}
		return true;
	}
	
	private boolean solve(int node, int[] color, boolean[][] graph, int m, int V) {
		if (node == V)
			return true;
		
		for (int col = 1; col <= m; col++) {
			if (isSafe(node, col, color, graph, V)) {
				color[node] = col;
				
				if (solve(node + 1, color, graph, m, V)) {
					return true;
				}
				
				// backtrack
				color[node] = 0;
			}
		}
		
		return false;
	}
	boolean graphColoring(int v, int[][] edges, int m) {
		// code here
		boolean[][] graph = new boolean[v][v];
		for (int[] arr:edges)
			{
			graph[arr[0]][arr[1]] = true;
			graph[arr[1]][arr[0]] = true;
		}
		int[] color = new int[v];
		
		return solve(0, color, graph, m, v);
	}
}
