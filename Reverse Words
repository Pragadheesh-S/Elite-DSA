class Solution {
	public String reverseWords(String s) {
		// Code here
		int n = s.length();
		StringBuilder sb = new StringBuilder();
		int i = n - 1;
		while (i >= 0)
			{
			while (i >= 0 && s.charAt(i) == '.')i--;
			if (i<0)
				break;
			int st = i;
			while (i >= 0 && s.charAt(i) != '.')i--;
			StringBuilder bb = new StringBuilder();
			sb.append(s.substring(i + 1, st + 1));
		
			while (i >= 0 && s.charAt(i) == '.')
				i--;
			
			if (i >= 0)
				sb.append('.');
		}
		return sb.toString();
	}
}
