class Solution {
    private boolean isval(int[] arr,int t,int k)
    {
        int c=1;
        int min=arr[0];
        for(int i=1;i<arr.length;i++)
        {
            if((arr[i]-min)>=t)
            {
                c++;
                min=arr[i];
            }
             if (c >= k) return true;
        }
        return false;
    }
    public int aggressiveCows(int[] arr, int k) {
     
        int n=arr.length;
        Arrays.sort(arr);
        int st=0;
        int ed=arr[n-1]-arr[0];
        int ans =0;
    while(st<=ed)
    {
        int m=(st+ed)/2;
        if(isval(arr,m,k))
        {
          ans=m;
          st=m+1;
         
        }
        else
        {
          ed=m-1; 
        }
    }
    return ans;
    }

}
